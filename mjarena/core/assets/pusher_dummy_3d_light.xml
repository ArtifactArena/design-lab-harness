<mujoco model="pusher_dummy_3d_light">
  <compiler angle="radian"/>
  <default>
    <geom rgba="0.6 0.2 0.2 1.0" friction="0.6 0.005 0.0001"/>
  </default>
  <worldbody>
    <body name="chassis" pos="0 0 0.22">
      <freejoint name="root"/>
      <!-- Plastic chassis: density=950 from materials_store.yaml -->
      <geom name="body" type="box" size="0.59 0.47 0.085" density="950"
            friction="0.25 0.005 0.0001" rgba="0.95 0.95 0.95 1"/>
      <body name="wfl" pos="0.46 0.51 -0.02">
        <joint name="j_fl" type="hinge" axis="0 1 0"/>
        <!-- Rubber tires: density=1200, friction=1.2 from materials_store.yaml -->
        <geom name="g_fl" type="cylinder" size="0.20 0.068" euler="1.5708 0 0"
              density="1200" friction="1.2 0.005 0.0001" priority="2"
              rgba="0.15 0.15 0.15 1"/>
      </body>
      <body name="wfr" pos="0.46 -0.51 -0.02">
        <joint name="j_fr" type="hinge" axis="0 1 0"/>
        <geom name="g_fr" type="cylinder" size="0.20 0.068" euler="1.5708 0 0"
              density="1200" friction="1.2 0.005 0.0001" priority="2"
              rgba="0.15 0.15 0.15 1"/>
      </body>
      <body name="wrl" pos="-0.46 0.51 -0.02">
        <joint name="j_rl" type="hinge" axis="0 1 0"/>
        <geom name="g_rl" type="cylinder" size="0.20 0.068" euler="1.5708 0 0"
              density="1200" friction="1.2 0.005 0.0001" priority="2"
              rgba="0.15 0.15 0.15 1"/>
      </body>
      <body name="wrr" pos="-0.46 -0.51 -0.02">
        <joint name="j_rr" type="hinge" axis="0 1 0"/>
        <geom name="g_rr" type="cylinder" size="0.20 0.068" euler="1.5708 0 0"
              density="1200" friction="1.2 0.005 0.0001" priority="2"
              rgba="0.15 0.15 0.15 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="m_fl" joint="j_fl" gear="150"/>
    <motor name="m_fr" joint="j_fr" gear="150"/>
    <motor name="m_rl" joint="j_rl" gear="150"/>
    <motor name="m_rr" joint="j_rr" gear="150"/>
  </actuator>
</mujoco>
