<?xml version="1.0" encoding="utf-8"?>
<!--
Stationary Block for Controller Validation

Moderate-mass stationary block for controller validation.

Uses moderate mass (~45 kg) so any reasonable controller can demonstrate
pushing ability. NOT meant to simulate a worst-case opponent.

Note: Has root joints for 2D physics (slide_x, slide_z, hinge_y) but no actuators,
so it just sits there until pushed.
-->
<mujoco model="stationary_block">
  <compiler angle="radian"/>

  <default>
    <geom rgba="0.5 0.5 0.5 1.0" friction="1.0 0.005 0.0001"/>
    <joint damping="0.5" armature="0.01"/>
  </default>

  <worldbody>
    <body name="block" pos="0 0 0">
      <!-- Root joints for 2D physics: slide in x-z plane, rotate about y -->
      <joint name="root_x" type="slide" axis="1 0 0" damping="0.1"/>
      <joint name="root_z" type="slide" axis="0 0 1" damping="0.1"/>
      <joint name="root_y" type="hinge" axis="0 1 0" damping="0.5"/>

      <!-- Max-size box: half-extents [0.75, 0.25, 0.5] = full size [1.5, 0.5, 1.0] -->
      <!-- Mass 180kg with density 1000 requires volume 0.18m3, but we use full size and override mass -->
      <geom name="block_geom" type="box" size="0.25 0.25 0.25"
            density="1000" mass="45"
            rgba="0.4 0.4 0.4 1.0"/>
    </body>
  </worldbody>

  <!-- No actuators - this is a stationary block -->
  <actuator>
  </actuator>
</mujoco>
